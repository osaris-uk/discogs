{
    "name": "osaris-uk/discogs",
    "description": "Laravel client for the Discogs API (v2). Authenticated requests only.",
    "keywords": [
        "laravel",
        "discogs",
        "api",
        "vinyl",
        "marketplace"
    ],
    "homepage": "https://github.com/osaris-uk/discogs",
    "license": "MIT",
    "authors": [
        {
            "name": "Osaris",
            "homepage": "https://github.com/osaris-uk"
        }
    ],
    "support": {
        "issues": "https://github.com/osaris-uk/discogs/issues",
        "source": "https://github.com/osaris-uk/discogs"
    },
    "type": "library",
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.8",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Osaris\\Discogs\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Osaris\\Discogs\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Osaris\\Discogs\\DiscogsServiceProvider"
            ],
            "aliases": {
                "Discogs": "Osaris\\Discogs\\Facades\\Discogs"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
